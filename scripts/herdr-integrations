#!/bin/sh
# Install herdr's Claude Code integration without running its hook twice.
#
# `herdr integration install claude` writes the herdr-managed hook script to
# ~/.claude/hooks/herdr-agent-state.sh and adds a SessionStart entry to
# ~/.claude/settings.json that calls it by absolute path (/home/<user>/...).
# .claude/settings.shared.json already carries an equivalent entry that goes
# through $HOME (Claude Code runs hook commands through a shell, so it
# expands), which `make link` merges into every account's settings.json.
# herdr only recognizes its own form and re-adds it on every install, so this
# script drops herdr's entry from the local file again afterwards.
# Idempotent; re-run after `herdr update`.
set -eu
umask 077
cd "$(dirname "$0")/.."

# Run from a `claude-<name>` session, herdr would follow CLAUDE_CONFIG_DIR to
# that account while the cleanup below edits ~/.claude. The shared hook entry
# points at ~/.claude/hooks anyway, so always install there.
unset CLAUDE_CONFIG_DIR

settings=$HOME/.claude/settings.json

# Make sure herdr edits a real local file, not a leftover symlink into the repo.
sh scripts/claude-settings "$HOME/.claude"

mise x -- herdr integration install claude

jq --arg q "'" '
  def herdr_own:
    any(.hooks[]?; .command
      | startswith("bash " + $q + "/") and endswith("/herdr-agent-state.sh" + $q + " session"));
  if .hooks.SessionStart then .hooks.SessionStart |= map(select(herdr_own | not)) else . end
  ' "$settings" > "$settings.tmp"
mv "$settings.tmp" "$settings"
echo "removed herdr's absolute-path hook entry from $settings"
